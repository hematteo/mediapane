{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mediapane claude hook 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
